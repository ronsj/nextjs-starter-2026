# PostgreSQL connection string
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/nextjs_starter

# Hosted Postgres (Railway, Neon, Supabase): enable TLS with cert validation
DATABASE_SSL=true
DATABASE_SSL_REJECT_UNAUTHORIZED=true

# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# App URL (used for auth callbacks)
BETTER_AUTH_URL=http://localhost:3000

# Comma-separated; defaults to BETTER_AUTH_URL if unset
# BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:3000

# Production: replace sendDevEmail in app/lib/auth.ts with a real provider (e.g. Resend)

